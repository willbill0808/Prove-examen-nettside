<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home — NordBank</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page">
        <h1>Welcome<% if (locals.user) { %>, <%= locals.user.User_name %><% } %></h1>
        <p class="subtitle">Your personal banking dashboard</p>

        <% if (locals.error) { %>
            <h2 class="error"><%= locals.error %></h2>
        <% } %>
    </div>
</body>
</html>
