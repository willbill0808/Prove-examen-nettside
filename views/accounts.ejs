<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accounts</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <nav>
        <button onclick="window.location.href='/'" class="button button3">Home</button>
        <button onclick="window.location.href='/users/log_in'" class="button button3">Log in</button>
        <button onclick="window.location.href='/users/sign_in'" class="button button3">Sign in</button>
        <button onclick="window.location.href='/accounts'" class="button button3">Card-Accounts</button>
        <button onclick="window.location.href='/accounts/create'" class="button button3">Create Card-Account</button>
        <button onclick="window.location.href='/accounts/money'" class="button button3">Transfer Money</button>

        <h3>
            <%= locals.user?.User_name || "Not logged in" %>
        </h3>
    </nav>
    
    <h3>
        <table cellpadding="6">
            <tr>
                <th>Account Name</th>
                <th>Account Number</th>
                <th>Balance</th>
            </tr>

            <% accounts.forEach(account=> { %>
                <tr>
                    <td>
                        <%= account.Account_name %>
                    </td>
                    <td>
                        <%= account.Account_number %>
                    </td>
                    <td>
                        <%= account.Balance %>
                    </td>
                </tr>
                <% }) %>
        </table>
    </h3>
</body>
</html>