<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <%- include("partials/nav") %>

    <form action="/users/log_in" method="post">
        <div id="form1">
            <h3>What is your username</h3>
            <input type="text" name="userName" id="userName" required>
        </div>

        <div id="form2">
            <h3>What is your Password</h3>
            <input type="password" name="userPass" id="userPass" required>
        </div>

        <h2 class="error"> <%= locals.error || null %> </h2>

        <input type="submit" value="Submit" class="button, button1" />
    </form>
    
</body>
</html>