<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In — NordBank</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page">
        <h1>Sign In</h1>
        <p class="subtitle">Access your NordBank account</p>

        <form action="/users/log_in" method="post">
            <h2>Your details</h2>

            <div id="form1">
                <h3>Username</h3>
                <input type="text" name="userName" id="userName" placeholder="Enter your username" required>
            </div>

            <div id="form2">
                <h3>Password</h3>
                <input type="password" name="userPass" id="userPass" placeholder="••••••••" required>
            </div>

            <% if (locals.error) { %>
                <h2 class="error"><%= locals.error %></h2>
            <% } %>

            <input type="submit" value="Log In" class="button button1" />
        </form>
    </div>
</body>
</html>
