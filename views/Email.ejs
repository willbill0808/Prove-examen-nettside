<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email — NordBank</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page">
        <h1>Sign In</h1>
        <p class="subtitle">Add an Email to your account</p>

        <form action="/users/Email" method="post">

            <div id="form1">
                <h3>Email</h3>
                <input type="text" name="Email" id="Email" placeholder="Enter your Email" required>
            </div>

            <% if (locals.error) { %>
                <h4 class="error"><%= locals.error %></h4>
            <% } %>

            <% if (locals.text) { %>
                <h4 class="text"><%= locals.text %></h4>
            <% } %>

            <input type="submit" value="Log In" class="button button1" />
        </form>
    </div>
</body>
</html>
