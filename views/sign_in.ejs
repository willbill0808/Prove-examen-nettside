<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register — NordBank</title>
    <link rel="stylesheet" href="/css/<%= locals.user ? 'logged_in.css' : 'logged_out.css' %>">
</head>
<body>
    <%- include("partials/nav") %>

    <div class="page">
        <h1>Create Account</h1>
        <p class="subtitle">Join NordBank today — it only takes a minute</p>

        <form action="/users/sign_in" method="post">
            <h2>Choose your credentials</h2>

            <div id="form1">
                <h3>Username</h3>
                <input type="text" name="userName" id="userName" placeholder="Choose a username" required>
            </div>

            <div id="form2">
                <h3>Password</h3>
                <input type="password" name="userPass" id="userPass" placeholder="••••••••" required>
            </div>

            <div id="form3">
                <h3>Confirm Password</h3>
                <input type="password" name="userPass2" id="userPass2" placeholder="••••••••" required>
            </div>

            <% if (locals.error) { %>
                <h4 class="error"><%= locals.error %></h4>
            <% } %>

            <input type="submit" value="Create Account" class="button button1" />
        </form>
    </div>
</body>
</html>
